# Supabase — used by the client-side auth + saved-sessions features.
# The publishable ("anon") key is safe to expose in the browser; Row-Level
# Security protects the data. Copy this file to .env and fill in real values,
# and set the same two vars in Netlify → Site configuration → Environment variables.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# Phase 3 (in-site AI agents + subscription) — server-side only. These have no
# PUBLIC_ prefix, so Astro never exposes them to the browser. Set the same five
# in Netlify → Site configuration → Environment variables.
# Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-your-key
# Stripe: prefer a restricted key (Checkout Sessions write, Billing Portal
# write, Customers write, Subscriptions read). Test-mode keys first.
STRIPE_SECRET_KEY=rk_test_your_key
# Signing secret for the /api/stripe-webhook endpoint (from the Stripe
# dashboard webhook config, or `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=whsec_your_secret
# The $5/month recurring price for the AI assistants product.
STRIPE_PRICE_ID=price_your_price_id
# Supabase secret key (Project Settings → API keys). Bypasses RLS — server only.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key
