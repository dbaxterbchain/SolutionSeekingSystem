---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import CheckoutBanner from '../components/react/CheckoutBanner.tsx';

interface Props {
  title?: string;
  description?: string;
  /** JSON-LD schema objects rendered into <head>. */
  schemas?: Record<string, unknown>[];
  /** og:type — detail/content pages should pass 'article'. */
  type?: 'website' | 'article';
  /** Override the generated per-page OG card with a custom image path. */
  ogImage?: string;
  /** Path to a markdown rendering of this page, exposed for LLM agents. */
  markdownAlt?: string;
  /** Keep the page out of search indexes (account, 404). */
  noindex?: boolean;
}

const {
  title = 'Solution Seeking System',
  description = 'A framework for democratic problem solving, leadership, and communication. Understand yourself, understand each other, then seek a solution.',
  schemas = [],
  type = 'website',
  ogImage,
  markdownAlt,
  noindex = false,
} = Astro.props;

const fullTitle =
  title === 'Solution Seeking System' ? title : `${title} | Solution Seeking System`;
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site).href;

// Every prerendered page gets a matching generated card at /og/<path>.png
// (see src/pages/og/[...route].png.ts, which enumerates the same routes).
const pathKey = Astro.url.pathname.replace(/\/+$/, '') || '/index';
const ogImageUrl = new URL(ogImage ?? `/og${pathKey}.png`, site).href;

// Search Console / Bing Webmaster Tools ownership. Not secrets: the whole point
// is that the crawler reads them. Unset means the tag is simply omitted, so a
// DNS TXT verification (the alternative, and the one that survives a redesign)
// works just as well. Verification is what turns "we published 48 pages" into
// "we can see which queries find them".
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-M987NM67');
    </script>
    <!-- End Google Tag Manager -->
    <meta name="theme-color" content="#5271FF" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {markdownAlt && <link rel="alternate" type="text/markdown" href={markdownAlt} />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Solution Seeking System" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {schemas.map((schema) => <JsonLd schema={schema} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-M987NM67"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe
    ></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <CheckoutBanner client:idle />
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Remember where this visit came from BEFORE anything else can navigate or
      // rewrite the URL. An ad click arrives as ?gclid= on the landing page, but
      // the purchase happens later, on the far side of an OAuth redirect that
      // destroys the query string, so it has to be caught on arrival.
      import { captureFirstTouch } from '../lib/attribution';
      captureFirstTouch();

      // One delegated listener powers every [data-track-cta] link on the site,
      // so static pages can be instrumented without shipping an island.
      import { initDomTracking } from '../lib/analytics';
      initDomTracking();
    </script>
  </body>
</html>
