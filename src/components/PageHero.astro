---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="border-b border-slate-100 bg-gradient-to-b from-brand-50/70 to-white">
  <div class="container-page py-14 sm:py-20">
    {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
    <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight text-ink-800 sm:text-5xl">
      {title}
    </h1>
    {
      intro && (
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600">{intro}</p>
      )
    }
    <slot />
  </div>
</section>
