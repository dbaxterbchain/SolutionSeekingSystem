---
import type { Testimonial } from '../lib/server/testimonials';

/**
 * Real quotes from real people, published with their consent.
 *
 * Renders the inner block only (no <section>, no background), so the page owns
 * the section chrome. Same convention as DemoExcerpt.astro, and it is what lets
 * this sit inside the home page's full-bleed bands and inside /pricing's
 * `<section class="mt-16">` without either fighting the other.
 *
 * Attribution is OPTIONAL and must never be papered over. A person may consent
 * to being quoted without giving a name, and when they do we print the quote and
 * nothing else. No "Verified user", no stock avatar, no initials we invented.
 * An unattributed real quote is worth more than an attributed fake one, and the
 * moment we dress one up as the other we have spent the only credibility we have.
 */
interface Props {
  quotes: Testimonial[];
  heading?: string;
  intro?: string;
}

const {
  quotes,
  heading = 'What people say after using it',
  intro,
} = Astro.props;

const attribution = (t: Testimonial) =>
  [t.display_name, t.role_title].filter(Boolean).join(', ');
---

<div>
  <div class="mx-auto max-w-2xl text-center">
    <p class="eyebrow mb-3">In their words</p>
    <h2 class="text-3xl font-bold text-ink-800 sm:text-4xl">{heading}</h2>
    {intro && <p class="mt-4 leading-relaxed text-slate-600">{intro}</p>}
  </div>

  <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      quotes.map((t) => (
        <figure class="flex flex-col rounded-2xl border border-slate-100 bg-white p-6 shadow-card">
          <blockquote class="flex-1 text-sm leading-relaxed text-slate-700">
            <p>"{t.quote}"</p>
          </blockquote>
          {attribution(t) && (
            <figcaption class="mt-4 border-t border-slate-100 pt-3 text-xs font-semibold text-slate-500">
              {attribution(t)}
            </figcaption>
          )}
        </figure>
      ))
    }
  </div>

  <p class="mt-6 text-center text-xs text-slate-400">
    Real feedback, published with permission. Names are shown only where the person gave one.
  </p>
</div>
