---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  order: number;
  title: string;
  tagline: string;
  icon: string;
  href: string;
  image?: ImageMetadata;
}
const { order, title, tagline, icon, href, image } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-card transition-all duration-200 hover:-translate-y-1 hover:border-brand-200 hover:shadow-card-hover"
>
  {
    image && (
      <Image
        src={image}
        alt=""
        widths={[300, 500]}
        sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
        class="aspect-[4/3] w-full object-cover"
      />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center justify-between">
      <span class="text-3xl" aria-hidden="true">{icon}</span>
      <span class="font-display text-2xl leading-none text-brand-100 transition-colors group-hover:text-brand-200">
        {String(order).padStart(2, '0')}
      </span>
    </div>
    <h3 class="mt-4 text-lg font-bold text-ink-800 group-hover:text-brand-700">{title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{tagline}</p>
    <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600">
      Learn it
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
      </svg>
    </span>
  </div>
</a>
