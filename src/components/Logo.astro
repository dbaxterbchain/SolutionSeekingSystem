---
interface Props {
  /** Render light text for use on dark backgrounds. */
  variant?: 'default' | 'light';
  class?: string;
  /** Tailwind size utilities for the logo mark (defaults to h-9 w-9). */
  iconClass?: string;
}
const { variant = 'default', class: className = '', iconClass = 'h-9 w-9' } = Astro.props;
const wordColor = variant === 'light' ? 'text-white' : 'text-ink-800';
const subColor = variant === 'light' ? 'text-brand-200' : 'text-brand-500';
---

<a href="/" class={`group inline-flex items-center gap-2.5 ${className}`} aria-label="Solution Seeking System, home">
  <img
    src="/brand/logo-mark.svg"
    alt=""
    width="36"
    height="36"
    class={`${iconClass} shrink-0 transition-transform duration-200 group-hover:scale-105`}
    aria-hidden="true"
  />
  <span class="flex flex-col leading-none">
    <span class={`font-heading text-lg font-bold tracking-tight ${wordColor}`}>Solution Seeking</span>
    <span class={`text-[0.62rem] font-semibold uppercase tracking-[0.22em] ${subColor}`}>System</span>
  </span>
</a>
