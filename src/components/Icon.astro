---
/**
 * Renders one of the custom concept icons (src/assets/icons/<name>.svg).
 *
 * Astro inlines imported SVGs, so the artwork inherits the surrounding text
 * color through `currentColor`. Size and color come from `class`, e.g.
 * `<Icon name="protocol" class="h-9 w-9 text-brand-500" />`.
 *
 * Icons are decorative: every use sits beside a visible text label, so they are
 * hidden from assistive tech rather than given a redundant name.
 */
import type { IconName } from '../lib/icons';

import Protocol from '../assets/icons/protocol.svg';
import Principles from '../assets/icons/principles.svg';
import Tools from '../assets/icons/tools.svg';
import Introspection from '../assets/icons/introspection.svg';
import MutualUnderstanding from '../assets/icons/mutual-understanding.svg';
import SolutionSpark from '../assets/icons/solution-spark.svg';
import OneOnOne from '../assets/icons/one-on-one.svg';
import Feedback from '../assets/icons/feedback.svg';
import Targeted from '../assets/icons/targeted.svg';
import Sessions from '../assets/icons/sessions.svg';
import Understanding from '../assets/icons/understanding.svg';
import GoodFaith from '../assets/icons/good-faith.svg';
import Forgiveness from '../assets/icons/forgiveness.svg';
import HumilityPride from '../assets/icons/humility-pride.svg';
import Compassion from '../assets/icons/compassion.svg';
import Bravery from '../assets/icons/bravery.svg';
import Vulnerability from '../assets/icons/vulnerability.svg';
import Patience from '../assets/icons/patience.svg';
import Fairness from '../assets/icons/fairness.svg';
import Integrity from '../assets/icons/integrity.svg';
import Flexibility from '../assets/icons/flexibility.svg';
import CriticalThinking from '../assets/icons/critical-thinking.svg';

// Typed as Record<IconName, …> so a new name in src/lib/icons.ts fails the
// build here until its artwork is registered.
const ICONS: Record<IconName, typeof Protocol> = {
  protocol: Protocol,
  principles: Principles,
  tools: Tools,
  introspection: Introspection,
  'mutual-understanding': MutualUnderstanding,
  'solution-spark': SolutionSpark,
  'one-on-one': OneOnOne,
  feedback: Feedback,
  targeted: Targeted,
  sessions: Sessions,
  understanding: Understanding,
  'good-faith': GoodFaith,
  forgiveness: Forgiveness,
  'humility-pride': HumilityPride,
  compassion: Compassion,
  bravery: Bravery,
  vulnerability: Vulnerability,
  patience: Patience,
  fairness: Fairness,
  integrity: Integrity,
  flexibility: Flexibility,
  'critical-thinking': CriticalThinking,
};

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
const Svg = ICONS[name];
---

<Svg class={className} aria-hidden="true" />
