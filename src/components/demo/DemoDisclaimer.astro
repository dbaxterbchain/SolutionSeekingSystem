---
/**
 * The "this is fictional" label shown on demo cards and detail pages.
 * Fictional examples prove capability; never present them as customer stories.
 */
interface Props {
  /** Compact single-line variant for cards. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

{
  compact ? (
    <p class="text-xs text-slate-400">Fictional demonstration</p>
  ) : (
    <p class="inline-flex items-start gap-2 rounded-xl bg-slate-100 px-4 py-2.5 text-sm text-slate-600">
      <span aria-hidden="true">🎭</span>
      <span>
        This is a fictional demonstration, written to show how the assistant works — not a real
        user's conversation.
      </span>
    </p>
  )
}
