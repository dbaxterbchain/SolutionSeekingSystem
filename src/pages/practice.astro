---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const assistants = [
  {
    name: 'Solution Seeking Guide',
    blurb:
      'Walks you through the system to navigate a specific conflict and find a great solution — resolving conflicts, understanding yourself, and planning productive communication, step by step.',
    href: 'https://chatgpt.com/g/g-68981adb38108191a91907d44138505d-solution-seeking-guide',
    cta: 'Open the Guide',
    icon: '🧭',
  },
  {
    name: 'Solution Seeking Mentor',
    blurb:
      'Helps you with anything related to the system — explaining the framework, the 3-step protocol, the Wisdom Principles, and the Leadership Tools (or building your own).',
    href: 'https://chatgpt.com/g/g-6897eb5ac1d48191af7e78fefef86909-solution-seeking-mentor',
    cta: 'Open the Mentor',
    icon: '🎓',
  },
];

const upcoming = [
  {
    title: 'Guided Introspection worksheet',
    body: 'Walk through the 7-step introspection process with prompts, and produce a prep summary for your conversation.',
  },
  {
    title: 'Conversation planner',
    body: 'A Mutual Understanding checklist and question bank to prepare for a difficult conversation.',
  },
  {
    title: 'Solution builder',
    body: 'Check a drafted solution against the Actionable, Testable, Effective, and Time-bound criteria.',
  },
];
---

<BaseLayout
  title="Practice"
  description="Use the Solution Seeking System for yourself — with our Guide and Mentor assistants, and interactive tools."
>
  <PageHero
    eyebrow="Practice"
    title="Use the system for yourself"
    intro="Reading is a start — the system works when you practice it. Use our assistants for hands-on, step-by-step help right now, with interactive in-browser tools on the way."
  />

  <div class="container-page py-16">
    <!-- Assistants -->
    <div class="grid gap-6 md:grid-cols-2">
      {
        assistants.map((a) => (
          <div class="flex flex-col rounded-2xl border border-slate-100 bg-white p-7 shadow-card">
            <span class="text-3xl" aria-hidden="true">{a.icon}</span>
            <h2 class="mt-4 text-xl font-bold text-ink-800">{a.name}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{a.blurb}</p>
            <a href={a.href} rel="noopener" target="_blank" class="btn-primary mt-5 self-start">
              {a.cta}
            </a>
          </div>
        ))
      }
    </div>

    <!-- Coming soon -->
    <section class="mt-20">
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">On the way</p>
        <h2 class="text-3xl font-bold text-ink-800">Interactive practice tools</h2>
        <p class="mt-3 text-slate-600">
          We're building guided, in-browser tools so you can practice each part of the
          system directly on this site.
        </p>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-3">
        {
          upcoming.map((u) => (
            <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50/50 p-6">
              <span class="inline-block rounded-full bg-brand-100 px-2.5 py-1 text-xs font-semibold text-brand-700">
                Coming soon
              </span>
              <h3 class="mt-3 font-bold text-ink-800">{u.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{u.body}</p>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
