---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PricingLine from '../components/react/PricingLine.tsx';

const assistants = [
  {
    name: 'Solution Seeking Guide',
    blurb:
      'Walks you through the system to navigate a specific conflict and find a great solution: resolving conflicts, understanding yourself, and planning productive communication, step by step.',
    href: '/practice/guide',
    cta: 'Open the Guide',
    icon: '🧭',
  },
  {
    name: 'Solution Seeking Mentor',
    blurb:
      'Helps you with anything related to the system: explaining the framework, the 3-step protocol, the Wisdom Principles, and the Leadership Tools (or building your own).',
    href: '/practice/mentor',
    cta: 'Open the Mentor',
    icon: '🎓',
  },
];

const tools = [
  {
    title: 'Guided Introspection',
    body: 'Walk through the 7-step Introspection process with prompts, and produce a prep summary for your conversation.',
    icon: '🧭',
    href: '/practice/introspection',
    available: true,
  },
  {
    title: 'Conversation Planner',
    body: 'A Mutual Understanding checklist and question bank to prepare for a difficult conversation.',
    icon: '🤝',
    href: '/practice/conversation-planner',
    available: true,
  },
  {
    title: 'Solution Builder',
    body: 'Check a drafted solution against the Actionable, Testable, Effective, and Time-bound criteria.',
    icon: '💡',
    href: '/practice/solution-builder',
    available: true,
  },
];
---

<BaseLayout
  title="Practice"
  description="Use the Solution Seeking System for yourself, with our Guide and Mentor assistants, and interactive tools."
>
  <PageHero
    eyebrow="Practice"
    title="Use the system for yourself"
    intro="Reading is a start, but the system works when you practice it. Chat with our AI Guide and Mentor for hands-on, step-by-step help right here on the site, or use the free interactive tools below."
  />

  <div class="container-page py-16">
    <!-- Assistants -->
    <div class="grid gap-6 md:grid-cols-2">
      {
        assistants.map((a) => (
          <div class="flex flex-col rounded-2xl border border-slate-100 bg-white p-7 shadow-card">
            <span class="text-3xl" aria-hidden="true">{a.icon}</span>
            <h2 class="mt-4 text-xl font-bold text-ink-800">{a.name}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{a.blurb}</p>
            <a href={a.href} class="btn-primary mt-5 self-start">
              {a.cta}
            </a>
          </div>
        ))
      }
    </div>
    <p class="mt-4 text-sm text-slate-500">
      <PricingLine
        client:load
        generic="Sign in for 10 free messages · $5/month for unlimited conversations with both assistants."
        subscriber="You're subscribed — unlimited conversations with both assistants."
      />
    </p>

    <!-- Interactive tools -->
    <section class="mt-20">
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">Interactive tools</p>
        <h2 class="text-3xl font-bold text-ink-800">Practice each part of the system</h2>
        <p class="mt-3 text-slate-600">
          Guided, in-browser tools so you can practice the system directly on this site.
          Everything stays private on your device.
        </p>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-3">
        {
          tools.map((t) =>
            t.available ? (
              <a
                href={t.href}
                class="group flex flex-col rounded-2xl border border-slate-100 bg-white p-6 shadow-card transition-all duration-200 hover:-translate-y-1 hover:border-brand-200 hover:shadow-card-hover"
              >
                <span class="text-2xl" aria-hidden="true">{t.icon}</span>
                <h3 class="mt-3 font-bold text-ink-800 group-hover:text-brand-700">{t.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{t.body}</p>
                <span class="mt-4 text-sm font-semibold text-brand-600">Open the tool →</span>
              </a>
            ) : (
              <div class="flex flex-col rounded-2xl border border-dashed border-slate-200 bg-slate-50/50 p-6">
                <span class="text-2xl opacity-60" aria-hidden="true">{t.icon}</span>
                <span class="mt-3 inline-block w-fit rounded-full bg-brand-100 px-2.5 py-1 text-xs font-semibold text-brand-700">
                  Coming soon
                </span>
                <h3 class="mt-2 font-bold text-ink-800">{t.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{t.body}</p>
              </div>
            )
          )
        }
      </div>
    </section>
  </div>
</BaseLayout>
