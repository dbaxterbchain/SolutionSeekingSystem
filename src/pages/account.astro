---
import BaseLayout from '../layouts/BaseLayout.astro';
import AccountView from '../components/react/AccountView.tsx';
---

<BaseLayout
  title="Account"
  description="Sign in or create a free account to save and revisit your introspections, conversation plans, and solution checks."
  noindex
>
  <section class="border-b border-slate-100 bg-gradient-to-b from-brand-50/70 to-white">
    <div class="container-page py-12 sm:py-16">
      <p class="eyebrow mt-2">Account</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink-800 sm:text-5xl">
        Your account
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600">
        Your subscription, AI conversations, and saved practice work — all in one place.
      </p>
    </div>
  </section>

  <div class="container-page py-12">
    <div class="mx-auto max-w-3xl">
      <AccountView client:load />
    </div>
  </div>
</BaseLayout>
