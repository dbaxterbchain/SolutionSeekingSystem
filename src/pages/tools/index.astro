---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { breadcrumbs, collectionPage, howTo } from '../../lib/schema';

const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);

const buildSteps = [
  'List the tools you use. What are their goals, use cases, and triggers? Why did you create that process in the first place?',
  'Determine which parts of the Communication Protocol could be used within that tool, and make a note of it.',
  'Use best practices from the protocol in your tools, and keep track of the Solutions created so your system can grow as more are found.',
];

const site = Astro.site ?? Astro.url;
const schemas = [
  breadcrumbs(site, [
    { name: 'Home', path: '/' },
    { name: 'Leadership Tools', path: '/tools' },
  ]),
  collectionPage(site, {
    name: 'The 4 Leadership Tools',
    description:
      'Real practices that apply the Communication Protocol: One-on-Ones, Feedback, Targeted Conversations, and Solution Seeking Sessions.',
    path: '/tools',
    items: tools.map((t) => ({ name: t.data.title, path: `/tools/${t.id}` })),
  }),
  howTo({
    name: 'Adapt the Communication Protocol into your existing tools',
    description:
      'Build the Communication Protocol into the leadership tools your organization already uses.',
    steps: buildSteps.map((text, i) => ({ name: `Step ${i + 1}`, text })),
  }),
];
---

<BaseLayout
  title="Leadership Tools"
  description="Real practices that apply the Communication Protocol: One-on-Ones, Feedback, Targeted Conversations, and Solution Seeking Sessions."
  schemas={schemas}
>
  <PageHero
    eyebrow="Leadership Tools"
    title="Putting the protocol to work"
    intro="The Solution Seeking System layers onto existing leadership styles. You don't need to change your structure, just improve how people communicate within it. These are the tools we use at Beanchain. Use them, adapt them, or build your own."
  />

  <div class="container-page py-16">
    <div class="grid gap-6 md:grid-cols-2">
      {
        tools.map((t) => (
          <a
            href={`/tools/${t.id}`}
            class="group flex flex-col rounded-2xl border border-slate-100 bg-white p-7 shadow-card transition-all duration-200 hover:-translate-y-1 hover:border-brand-200 hover:shadow-card-hover"
          >
            <span class="font-display text-2xl text-brand-100 group-hover:text-brand-200">
              {String(t.data.order).padStart(2, '0')}
            </span>
            <h2 class="mt-2 text-xl font-bold text-ink-800 group-hover:text-brand-700">{t.data.title}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{t.data.summary}</p>
            <span class="mt-4 text-sm font-semibold text-brand-600">How it works →</span>
          </a>
        ))
      }
    </div>

    <!-- Build your own -->
    <section class="mt-20 rounded-3xl border border-slate-100 bg-slate-50/70 p-8 sm:p-12">
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">Build your own</p>
        <h2 class="text-3xl font-bold text-ink-800">Adapt the protocol into your existing tools</h2>
        <p class="mt-3 text-slate-600">
          Building the Communication Protocol into your leadership tools is
          straightforward. Through this process you may find some existing tools are
          redundant. The more concise your toolset, the easier it is to teach.
        </p>
      </div>
      <ol class="mt-8 grid gap-5 sm:grid-cols-3">
        {
          buildSteps.map((s, i) => (
            <li class="rounded-2xl border border-slate-100 bg-white p-6">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-500 font-display text-lg text-white">
                {i + 1}
              </span>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{s}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</BaseLayout>
