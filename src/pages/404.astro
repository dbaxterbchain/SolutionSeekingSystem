---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="container-page flex flex-col items-center py-28 text-center">
    <p class="font-display text-7xl text-brand-200">404</p>
    <h1 class="mt-4 text-3xl font-bold text-ink-800">We couldn't find that page</h1>
    <p class="mt-3 max-w-md text-slate-600">
      The page may have moved. Let's get you back to learning the system.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Back home</a>
      <a href="/protocol" class="btn-secondary">The Protocol</a>
    </div>
  </section>
</BaseLayout>
