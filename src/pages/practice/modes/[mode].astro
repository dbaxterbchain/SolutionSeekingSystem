---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChatView from '../../../components/react/ChatView.tsx';
import PricingLine from '../../../components/react/PricingLine.tsx';
import Testimonials from '../../../components/Testimonials.astro';
import ProvenanceBand from '../../../components/ProvenanceBand.astro';
import { breadcrumbs, webApplication } from '../../../lib/schema';
import { CHAT_CONTEXTS } from '../../../lib/contexts';
import { MODES } from '../../../data/modes';
import { PLANS, priceCopy } from '../../../data/pricing';
import { getApprovedTestimonials } from '../../../lib/server/testimonials';

export async function getStaticPaths() {
  const demos = await getCollection('demos');

  // Every mode page must be backed by a registry entry the embedded Guide can
  // actually use — fail the build instead of shipping a dead mode.
  for (const mode of MODES) {
    const ctx = CHAT_CONTEXTS.find((c) => c.id === mode.id);
    if (!ctx || ctx.kind !== 'mode') {
      throw new Error(
        `Mode page "${mode.id}" has no kind:'mode' registry entry in src/lib/contexts.ts`
      );
    }
    if (!ctx.agents.includes('guide')) {
      throw new Error(
        `Mode "${mode.id}" must be Guide-applicable: its landing page embeds the Guide`
      );
    }
    if (mode.mentorCta && !ctx.agents.includes('mentor')) {
      throw new Error(
        `Mode "${mode.id}" has mentorCta copy but its registry entry doesn't allow the mentor`
      );
    }
    for (const id of mode.relatedDemoIds ?? []) {
      if (!demos.some((d) => d.id === id)) {
        throw new Error(`Mode "${mode.id}" references unknown demo "${id}"`);
      }
    }
  }

  return MODES.map((mode) => ({
    params: { mode: mode.id },
    props: {
      mode,
      relatedDemos: demos.filter((d) => mode.relatedDemoIds?.includes(d.id)),
    },
  }));
}

const { mode, relatedDemos } = Astro.props;

// Approved, consented quotes, read at build time. Empty until real people write
// some, and the section below then renders nothing at all. Memoised across the
// eight mode pages, so this is one query per build, not eight.
const quotes = await getApprovedTestimonials();

const site = Astro.site ?? Astro.url;
const schemas = [
  webApplication(site, {
    name: `Solution Seeking Guide (${mode.name} mode)`,
    description: mode.metaDescription,
    path: `/practice/modes/${mode.id}`,
    offer: { price: PLANS.monthly.priceAmount },
  }),
  breadcrumbs(site, [
    { name: 'Home', path: '/' },
    { name: 'Practice', path: '/practice' },
    { name: 'Modes', path: '/practice/modes' },
    { name: mode.name, path: `/practice/modes/${mode.id}` },
  ]),
];
---

<BaseLayout title={mode.heroTitle} description={mode.metaDescription} schemas={schemas}>
  {/*
    The hero is deliberately SHORTER on a phone than on a desktop. It used to eat
    639px of an 844px screen, which left no room for the one thing the page is
    for. Every size below that starts small and grows at `sm:` is doing that job:
    the desktop hero is unchanged.
  */}
  <section class="border-b border-slate-100 bg-gradient-to-b from-brand-50/70 to-white">
    <div class="container-page py-6 sm:py-16">
      {/* A "back to the index" link is not what a paid visitor needs from their
          first screen, so it waits until there is room for it. */}
      <a
        href="/practice/modes"
        class="hidden text-sm font-semibold text-brand-600 hover:text-brand-700 sm:inline-block"
      >
        ← All modes
      </a>
      <p class="eyebrow mt-0 sm:mt-4">AI Assistant · {mode.icon} {mode.name} mode</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink-800 sm:text-5xl">
        {mode.heroTitle}
      </h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-slate-600 sm:mt-4 sm:text-lg">
        {mode.heroIntro}
        {/* client:idle, not client:load: this renders one sentence, and it has no
            business competing with the chat for the main thread. */}
        <PricingLine
          client:idle
          generic={priceCopy.generic}
          subscriber="You're subscribed: unlimited conversations, anytime."
        />
      </p>
      {/* One tap to the thing the visitor came for. Most arrivals here are on a
          phone, where the composer is otherwise a scroll away. */}
      <a
        href="#chat"
        class="btn-primary mt-4 inline-block sm:hidden"
        data-track-cta="mode_page"
        data-track-label="Start the conversation"
      >
        Start the conversation
      </a>
    </div>
  </section>

  <div class="container-page py-6 sm:py-12">
    <div class="mx-auto max-w-5xl">
      {/*
        The chat comes FIRST, above the supporting copy.

        It used to sit below the hero AND a "When this helps" card, which on a
        390px phone put the composer a full screen down. That is the one thing a
        visitor is here to use, and on a paid click it is the conversion. The
        situations list reads perfectly well as supporting detail underneath.

        scroll-mt-20 because the header is sticky: a bare #chat anchor would park
        the top of the chat underneath it.
      */}
      <div id="chat" class="scroll-mt-20">
        <ChatView
          client:load
          agent="guide"
          agentName="Guide"
          welcome={mode.welcome}
          initialContext={mode.id}
        />
      </div>

      <div class="mt-8 rounded-2xl border border-slate-100 bg-slate-50/70 p-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-emerald-700">
          When this helps
        </h2>
        <ul class="mt-3 space-y-2 text-sm text-slate-700">
          {
            mode.exampleSituations.map((s) => (
              <li class="relative pl-5">
                <span class="absolute left-0 top-1.5 h-1.5 w-1.5 rounded-full bg-emerald-500" />
                {s}
              </li>
            ))
          }
        </ul>
      </div>

      {/*
        Trust signals, BELOW the chat and never above it. A cold visitor from an
        ad has no idea who we are, and these pages carried nothing at all. But
        anything placed above the composer pushes it off a phone screen, which
        costs the very thing we are paying for. So: proof, after the product.

        Testimonials render only when a real, consented, approved quote exists,
        so today this is silent and it lights up on its own the moment one does.
      */}
      {
        quotes.length > 0 && (
          <div class="mt-12">
            <Testimonials quotes={quotes} heading="What people say after using it" />
          </div>
        )
      }

      <div class="mt-10 border-t border-slate-100 pt-8">
        <ProvenanceBand compact />
      </div>

      {
        mode.mentorCta && (
          <div class="mt-8 rounded-2xl border border-brand-100 bg-brand-50/60 p-6">
            <p class="text-sm leading-relaxed text-slate-700">{mode.mentorCta}</p>
            <a
              href={`/practice/mentor?context=${mode.id}`}
              class="mt-3 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700"
              data-track-cta="mode_page_mentor"
              data-track-label={`Open the Mentor in ${mode.name} mode`}
            >
              Open the Mentor in {mode.name} mode →
            </a>
          </div>
        )
      }

      {
        relatedDemos.length > 0 && (
          <div class="mt-8 rounded-2xl border border-slate-100 bg-white p-6 shadow-card">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">
              See a full example conversation
            </h2>
            <ul class="mt-3 space-y-2 text-sm">
              {relatedDemos.map((d) => (
                <li>
                  <a
                    href={`/practice/demos/${d.id}`}
                    class="font-semibold text-brand-600 hover:text-brand-700"
                  >
                    {d.data.title} →
                  </a>
                  <span class="ml-1 text-slate-500">{d.data.scenario}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <p class="mt-6 text-center text-sm text-slate-500">
        Conversations are saved to your account and only visible to you. Prefer a general
        conversation?
        <a href="/practice/guide" class="font-medium text-brand-600 hover:text-brand-700">
          Open the Guide →
        </a>
        Or learn the system first:
        <a href="/protocol" class="font-medium text-brand-600 hover:text-brand-700">
          the Communication Protocol →
        </a>
      </p>
    </div>
  </div>

  <!-- Raw dataLayer push (no imports), so is:inline is correct here. -->
  <script is:inline define:vars={{ modeId: mode.id }}>
    (window.dataLayer = window.dataLayer || []).push({
      event: 'mode_viewed',
      mode_id: modeId,
    });
  </script>
</BaseLayout>
