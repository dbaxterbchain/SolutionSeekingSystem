---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChatView from '../../../components/react/ChatView.tsx';
import PricingLine from '../../../components/react/PricingLine.tsx';
import { breadcrumbs, webApplication } from '../../../lib/schema';
import { CHAT_CONTEXTS } from '../../../lib/contexts';
import { MODES } from '../../../data/modes';

export async function getStaticPaths() {
  const demos = await getCollection('demos');

  // Every mode page must be backed by a registry entry the embedded Guide can
  // actually use — fail the build instead of shipping a dead mode.
  for (const mode of MODES) {
    const ctx = CHAT_CONTEXTS.find((c) => c.id === mode.id);
    if (!ctx || ctx.kind !== 'mode') {
      throw new Error(
        `Mode page "${mode.id}" has no kind:'mode' registry entry in src/lib/contexts.ts`
      );
    }
    if (!ctx.agents.includes('guide')) {
      throw new Error(
        `Mode "${mode.id}" must be Guide-applicable: its landing page embeds the Guide`
      );
    }
    if (mode.mentorCta && !ctx.agents.includes('mentor')) {
      throw new Error(
        `Mode "${mode.id}" has mentorCta copy but its registry entry doesn't allow the mentor`
      );
    }
    for (const id of mode.relatedDemoIds ?? []) {
      if (!demos.some((d) => d.id === id)) {
        throw new Error(`Mode "${mode.id}" references unknown demo "${id}"`);
      }
    }
  }

  return MODES.map((mode) => ({
    params: { mode: mode.id },
    props: {
      mode,
      relatedDemos: demos.filter((d) => mode.relatedDemoIds?.includes(d.id)),
    },
  }));
}

const { mode, relatedDemos } = Astro.props;

const site = Astro.site ?? Astro.url;
const schemas = [
  webApplication(site, {
    name: `Solution Seeking Guide (${mode.name} mode)`,
    description: mode.metaDescription,
    path: `/practice/modes/${mode.id}`,
    offer: { price: '5.00' },
  }),
  breadcrumbs(site, [
    { name: 'Home', path: '/' },
    { name: 'Practice', path: '/practice' },
    { name: 'Modes', path: '/practice/modes' },
    { name: mode.name, path: `/practice/modes/${mode.id}` },
  ]),
];
---

<BaseLayout title={mode.heroTitle} description={mode.metaDescription} schemas={schemas}>
  <section class="border-b border-slate-100 bg-gradient-to-b from-brand-50/70 to-white">
    <div class="container-page py-12 sm:py-16">
      <a href="/practice/modes" class="text-sm font-semibold text-brand-600 hover:text-brand-700">
        ← All modes
      </a>
      <p class="eyebrow mt-4">AI Assistant · {mode.icon} {mode.name} mode</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink-800 sm:text-5xl">
        {mode.heroTitle}
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600">
        {mode.heroIntro}
        <PricingLine
          client:load
          generic="Your first 10 messages are free; $5/month for unlimited access."
          subscriber="You're subscribed: unlimited conversations, anytime."
        />
      </p>
    </div>
  </section>

  <div class="container-page py-12">
    <div class="mx-auto max-w-5xl">
      <div class="mb-8 rounded-2xl border border-slate-100 bg-slate-50/70 p-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-emerald-700">
          When this helps
        </h2>
        <ul class="mt-3 space-y-2 text-sm text-slate-700">
          {
            mode.exampleSituations.map((s) => (
              <li class="relative pl-5">
                <span class="absolute left-0 top-1.5 h-1.5 w-1.5 rounded-full bg-emerald-500" />
                {s}
              </li>
            ))
          }
        </ul>
      </div>

      <ChatView
        client:load
        agent="guide"
        agentName="Guide"
        welcome={mode.welcome}
        initialContext={mode.id}
      />

      {
        mode.mentorCta && (
          <div class="mt-8 rounded-2xl border border-brand-100 bg-brand-50/60 p-6">
            <p class="text-sm leading-relaxed text-slate-700">{mode.mentorCta}</p>
            <a
              href={`/practice/mentor?context=${mode.id}`}
              class="mt-3 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700"
              data-track-cta="mode_page_mentor"
              data-track-label={`Open the Mentor in ${mode.name} mode`}
            >
              Open the Mentor in {mode.name} mode →
            </a>
          </div>
        )
      }

      {
        relatedDemos.length > 0 && (
          <div class="mt-8 rounded-2xl border border-slate-100 bg-white p-6 shadow-card">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">
              See a full example conversation
            </h2>
            <ul class="mt-3 space-y-2 text-sm">
              {relatedDemos.map((d) => (
                <li>
                  <a
                    href={`/practice/demos/${d.id}`}
                    class="font-semibold text-brand-600 hover:text-brand-700"
                  >
                    {d.data.title} →
                  </a>
                  <span class="ml-1 text-slate-500">{d.data.scenario}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <p class="mt-6 text-center text-sm text-slate-500">
        Conversations are saved to your account and only visible to you. Prefer a general
        conversation?
        <a href="/practice/guide" class="font-medium text-brand-600 hover:text-brand-700">
          Open the Guide →
        </a>
        Or learn the system first:
        <a href="/protocol" class="font-medium text-brand-600 hover:text-brand-700">
          the Communication Protocol →
        </a>
      </p>
    </div>
  </div>

  <!-- Raw dataLayer push (no imports), so is:inline is correct here. -->
  <script is:inline define:vars={{ modeId: mode.id }}>
    (window.dataLayer = window.dataLayer || []).push({
      event: 'mode_viewed',
      mode_id: modeId,
    });
  </script>
</BaseLayout>
