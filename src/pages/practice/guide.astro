---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChatView from '../../components/react/ChatView.tsx';
import PricingLine from '../../components/react/PricingLine.tsx';
import { breadcrumbs, webApplication } from '../../lib/schema';
import { MODES } from '../../data/modes';

const site = Astro.site ?? Astro.url;
const schemas = [
  webApplication(site, {
    name: 'Solution Seeking Guide',
    description:
      'An AI guide that walks you through the Communication Protocol for a real conflict: understand yourself, prepare the conversation, and leave with a plan.',
    path: '/practice/guide',
    offer: { price: '5.00' },
  }),
  breadcrumbs(site, [
    { name: 'Home', path: '/' },
    { name: 'Practice', path: '/practice' },
    { name: 'Solution Seeking Guide', path: '/practice/guide' },
  ]),
];
---

<BaseLayout
  title="Solution Seeking Guide"
  description="Chat with the Solution Seeking Guide: an AI assistant that walks you through the Communication Protocol step by step to navigate a specific conflict."
  schemas={schemas}
>
  <section class="border-b border-slate-100 bg-gradient-to-b from-brand-50/70 to-white">
    <div class="container-page py-12 sm:py-16">
      <a href="/practice" class="text-sm font-semibold text-brand-600 hover:text-brand-700">
        ← Practice
      </a>
      <p class="eyebrow mt-4">AI Assistant · 🧭</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink-800 sm:text-5xl">
        Solution Seeking Guide
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600">
        Navigating a real conflict? The Guide walks you through the Communication Protocol
        one step at a time: understand yourself, practice the conversation, and leave with
        a concrete plan.
        <PricingLine
          client:load
          generic="Your first 10 messages are free; $5/month for unlimited access."
          subscriber="You're subscribed: unlimited conversations, anytime."
        />
      </p>
    </div>
  </section>

  <div class="container-page py-12">
    <div class="mx-auto max-w-5xl">
      <ChatView
        client:load
        agent="guide"
        agentName="Guide"
        welcome="Hi, I'm the Solution Seeking Guide. I can walk you through the Communication Protocol to help with a specific interpersonal challenge. Tell me a bit about what's going on, or just say hello and we'll take it from there."
      />
      <section class="mt-14">
        <p class="eyebrow mb-2">Modes</p>
        <h2 class="text-2xl font-bold text-ink-800">Who is the conversation with?</h2>
        <p class="mt-2 text-sm text-slate-600">
          The Guide can adapt to the relationship. Pick a mode to start oriented to it.
        </p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            MODES.map((mode) => (
              <a
                href={`/practice/modes/${mode.id}`}
                class="group flex items-start gap-3 rounded-2xl border border-slate-100 bg-white p-4 shadow-card transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-card-hover"
              >
                <span class="text-2xl" aria-hidden="true">
                  {mode.icon}
                </span>
                <span>
                  <span class="block font-bold text-ink-800 group-hover:text-brand-700">
                    {mode.name} mode
                  </span>
                  <span class="mt-0.5 block text-sm leading-relaxed text-slate-600">
                    {mode.pickerBlurb}
                  </span>
                </span>
              </a>
            ))
          }
        </div>
        <p class="mt-4">
          <a
            href="/practice/modes"
            class="text-sm font-semibold text-brand-600 hover:text-brand-700"
          >
            Browse all modes →
          </a>
        </p>
      </section>

      <p class="mt-8 text-center text-sm text-slate-500">
        Conversations are saved to your account and only visible to you. Not sure what a
        conversation looks like?
        <a href="/practice/demos" class="font-medium text-brand-600 hover:text-brand-700">
          See annotated examples →
        </a>
        Or learn the system first:
        <a href="/protocol" class="font-medium text-brand-600 hover:text-brand-700">
          the Communication Protocol →
        </a>
      </p>
    </div>
  </div>
</BaseLayout>
