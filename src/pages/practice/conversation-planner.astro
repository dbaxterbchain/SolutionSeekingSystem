---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConversationPlanner from '../../components/react/ConversationPlanner.tsx';
---

<BaseLayout
  title="Conversation Planner"
  description="Prepare for a Mutual Understanding conversation: a setup checklist, your goals and opening lines, a question bank, and listening reminders — built into a plan you can copy."
>
  <section class="border-b border-slate-100 bg-gradient-to-b from-brand-50/70 to-white">
    <div class="container-page py-12 sm:py-16">
      <a href="/practice" class="text-sm font-semibold text-brand-600 hover:text-brand-700">
        ← Practice
      </a>
      <p class="eyebrow mt-4">Communication Protocol · Step 2</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink-800 sm:text-5xl">
        Conversation Planner
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600">
        Set yourself up for a productive Mutual Understanding conversation. Work through
        the stage, your goals, how you’ll open, the questions you’ll ask, and how you’ll
        listen — then take the plan with you. Everything stays private in your browser.
      </p>
    </div>
  </section>

  <div class="container-page py-12">
    <div class="mx-auto max-w-3xl">
      <ConversationPlanner client:load />

      <p class="mt-6 text-center text-sm text-slate-500">
        Want the full picture?
        <a href="/protocol/mutual-understanding" class="font-medium text-brand-600 hover:text-brand-700">
          Read about Mutual Understanding →
        </a>
      </p>
    </div>
  </div>
</BaseLayout>
