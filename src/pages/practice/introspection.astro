---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IntrospectionWorksheet from '../../components/react/IntrospectionWorksheet.tsx';
import SavedForTool from '../../components/react/SavedForTool.tsx';
import { breadcrumbs, webApplication } from '../../lib/schema';

const site = Astro.site ?? Astro.url;
const schemas = [
  webApplication(site, {
    name: 'Guided Introspection Worksheet',
    description:
      'A free, in-browser worksheet that walks you through the 7-step Introspection process and produces a prep summary for your conversation.',
    path: '/practice/introspection',
  }),
  breadcrumbs(site, [
    { name: 'Home', path: '/' },
    { name: 'Practice', path: '/practice' },
    { name: 'Guided Introspection', path: '/practice/introspection' },
  ]),
];
---

<BaseLayout
  title="Guided Introspection"
  description="A guided, in-browser worksheet that walks you through the 7-step Introspection process and produces a prep summary for your conversation."
  schemas={schemas}
>
  <section class="border-b border-slate-100 bg-gradient-to-b from-brand-50/70 to-white">
    <div class="container-page py-12 sm:py-16">
      <a href="/practice" class="text-sm font-semibold text-brand-600 hover:text-brand-700">
        ← Practice
      </a>
      <p class="eyebrow mt-4">Communication Protocol · Step 1</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink-800 sm:text-5xl">
        Guided Introspection
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600">
        Before a difficult conversation, understand yourself first. This worksheet walks
        you through the seven steps of Introspection and pulls your answers into a prep
        summary you can bring with you. Everything stays private in your browser.
      </p>
    </div>
  </section>

  <div class="container-page py-12">
    <div class="mx-auto max-w-3xl">
      <IntrospectionWorksheet client:load />

      <SavedForTool client:load tool="introspection" />

      <p class="mt-6 text-center text-sm text-slate-500">
        Your answers are saved only on this device. Want the full picture?
        <a href="/protocol/introspection" class="font-medium text-brand-600 hover:text-brand-700">
          Read about the Introspection step →
        </a>
      </p>
    </div>
  </div>
</BaseLayout>
