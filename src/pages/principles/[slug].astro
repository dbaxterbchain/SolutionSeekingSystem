---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StepNav from '../../components/StepNav.astro';

export async function getStaticPaths() {
  const principles = (await getCollection('principles')).sort(
    (a, b) => a.data.order - b.data.order
  );
  return principles.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: principles[i - 1],
      next: principles[i + 1],
    },
  }));
}

const { entry, prev, next } = Astro.props;
const p = entry.data;
---

<BaseLayout title={p.title} description={p.tagline}>
  <section class="border-b border-slate-100 bg-gradient-to-b from-brand-50/70 to-white">
    <div class="container-page py-12 sm:py-16">
      <a href="/principles" class="text-sm font-semibold text-brand-600 hover:text-brand-700">
        ← Wisdom Principles
      </a>
      <div class="mt-5 flex items-start gap-4">
        <span class="text-5xl" aria-hidden="true">{p.icon}</span>
        <div>
          <p class="eyebrow">Principle {String(p.order).padStart(2, '0')} of 12</p>
          <h1 class="mt-1 text-4xl font-extrabold tracking-tight text-ink-800 sm:text-5xl">
            {p.title}
          </h1>
        </div>
      </div>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600">{p.tagline}</p>
    </div>
  </section>

  <div class="container-page py-14">
    <article class="mx-auto max-w-3xl space-y-12">
      <!-- 1. Description -->
      <section>
        <h2 class="text-2xl font-bold text-ink-800">Description</h2>
        <div class="mt-4 space-y-4 leading-relaxed text-slate-700">
          <p><strong class="font-semibold text-ink-800">What it is.</strong> {p.whatItIs}</p>
          <p>
            <strong class="font-semibold text-ink-800">How it's used in the system.</strong>
            {' '}{p.howUsed}
          </p>
        </div>
      </section>

      <!-- 2 & 3: Best Practices + Goals -->
      <div class="grid gap-6 sm:grid-cols-2">
        <section class="rounded-2xl border border-slate-100 bg-white p-6 shadow-card">
          <h2 class="text-lg font-bold text-ink-800">Best Practices</h2>
          <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-slate-700">
            {p.bestPractices.map((b) => (
              <li class="relative pl-6">
                <span class="absolute left-0 top-2 h-2 w-2 rounded-full bg-brand-400"></span>
                {b}
              </li>
            ))}
          </ul>
        </section>
        <section class="rounded-2xl border border-slate-100 bg-white p-6 shadow-card">
          <h2 class="text-lg font-bold text-ink-800">Goals</h2>
          <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-slate-700">
            {p.goals.map((g) => (
              <li class="relative pl-6">
                <span class="absolute left-0 top-2 h-2 w-2 rounded-full bg-emerald-400"></span>
                {g}
              </li>
            ))}
          </ul>
        </section>
      </div>

      <!-- 4. Antigoals -->
      <section class="rounded-2xl border border-amber-200/70 bg-amber-50/50 p-6">
        <h2 class="text-lg font-bold text-ink-800">Antigoals — what we don't want</h2>
        <ul class="mt-4 grid gap-2.5 text-sm leading-relaxed text-slate-700 sm:grid-cols-2">
          {p.antigoals.map((a) => (
            <li class="relative pl-6">
              <span class="absolute left-0 top-2 h-2 w-2 rounded-full bg-amber-500"></span>
              {a}
            </li>
          ))}
        </ul>
      </section>

      <!-- 5. Practice Patterns -->
      <section>
        <h2 class="text-2xl font-bold text-ink-800">Practice Patterns</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          {p.practices.map((pr) => (
            <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-5">
              <h3 class="font-semibold text-brand-700">{pr.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{pr.body}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 6. FAQ -->
      <section>
        <h2 class="text-2xl font-bold text-ink-800">FAQ &amp; Common Issues</h2>
        <div class="mt-4 space-y-3">
          {p.faq.map((f) => (
            <details class="group rounded-2xl border border-slate-100 bg-white p-5 shadow-card [&_svg]:open:rotate-180">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-ink-800 marker:content-['']">
                {f.q}
                <svg class="h-5 w-5 shrink-0 text-brand-400 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Worked example -->
      <section class="rounded-2xl bg-brand-50/70 p-6 sm:p-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-600">
          Solution Seeking in action
        </h2>
        <p class="mt-3 leading-relaxed text-ink-700">{p.example}</p>
      </section>

      <StepNav
        prev={prev ? { title: prev.data.title, href: `/principles/${prev.id}` } : undefined}
        next={next ? { title: next.data.title, href: `/principles/${next.id}` } : undefined}
      />
    </article>
  </div>
</BaseLayout>
