---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StepNav from '../../components/StepNav.astro';
import TryItBand from '../../components/TryItBand.astro';
import { breadcrumbs, learningArticle } from '../../lib/schema';

export async function getStaticPaths() {
  const steps = (await getCollection('protocol')).sort((a, b) => a.data.step - b.data.step);
  return steps.map((entry, i) => ({
    params: { step: entry.id },
    props: {
      entry,
      prev: steps[i - 1],
      next: steps[i + 1],
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

const site = Astro.site ?? Astro.url;
const schemas = [
  learningArticle(site, {
    headline: `Communication Protocol, Step ${entry.data.step} of 3: ${entry.data.title}`,
    description: entry.data.summary,
    path: `/protocol/${entry.id}`,
    teaches: entry.data.title,
  }),
  breadcrumbs(site, [
    { name: 'Home', path: '/' },
    { name: 'Communication Protocol', path: '/protocol' },
    { name: entry.data.title, path: `/protocol/${entry.id}` },
  ]),
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  schemas={schemas}
  type="article"
  markdownAlt={`/protocol/${entry.id}.md`}
>
  <section class="border-b border-slate-100 bg-gradient-to-b from-brand-50/70 to-white">
    <div class="container-page py-12 sm:py-16">
      <a href="/protocol" class="text-sm font-semibold text-brand-600 hover:text-brand-700">
        ← Communication Protocol
      </a>
      <div class="mt-4 flex items-center gap-4">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-500 font-display text-2xl text-white">
          {entry.data.step}
        </span>
        <p class="eyebrow">Step {entry.data.step} of 3</p>
      </div>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-ink-800 sm:text-5xl">
        {entry.data.title}
      </h1>
      <p class="mt-4 max-w-2xl text-lg font-medium text-brand-600">{entry.data.oneLine}</p>
    </div>
  </section>

  <div class="container-page py-14">
    <div class="grid gap-12 lg:grid-cols-[1fr_280px]">
      <article class="prose-sss order-2 lg:order-1">
        <Content />
        <StepNav
          prev={prev ? { title: prev.data.title, href: `/protocol/${prev.id}` } : undefined}
          next={next ? { title: next.data.title, href: `/protocol/${next.id}` } : undefined}
        />
      </article>

      <aside class="order-1 lg:order-2">
        <div class="sticky top-24 rounded-2xl border border-slate-100 bg-slate-50/70 p-6">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-600">
            What this step requires
          </h2>
          <ul class="mt-4 space-y-3">
            {
              entry.data.requires.map((r) => (
                <li>
                  {r.slug ? (
                    <a
                      href={`/principles/${r.slug}`}
                      class="block font-semibold text-ink-800 hover:text-brand-700"
                    >
                      {r.name}
                    </a>
                  ) : (
                    <span class="block font-semibold text-ink-800">{r.name}</span>
                  )}
                  <span class="text-sm text-slate-600">{r.why}</span>
                </li>
              ))
            }
          </ul>
          <a href="/principles" class="mt-5 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700">
            Explore the Wisdom Principles →
          </a>
        </div>
      </aside>
    </div>

    {/* Outside the article on purpose: `.prose-sss a` underlines every link it
        contains, which would fight the band's buttons. */}
    <div class="mt-14">
      <TryItBand
        ctaLocation="protocol_page"
        heading="Run this step on something real"
        body="Reading a step is one thing. Using it in the middle of an actual disagreement, when you are the one who is upset, is another. The Guide walks you through the whole protocol on your own situation, and the Wisdom Principles this step rests on are there whenever you want the reasoning."
        primary={{ href: '/practice/guide', label: 'Talk to the Guide' }}
        secondary={{ href: '/principles', label: 'Read the Wisdom Principles' }}
      />
    </div>
  </div>
</BaseLayout>
