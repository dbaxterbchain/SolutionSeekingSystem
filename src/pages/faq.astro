---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { breadcrumbs, faqPage } from '../lib/schema';
import { siteFaq } from '../data/faq';

const site = Astro.site ?? Astro.url;
const schemas = [
  breadcrumbs(site, [
    { name: 'Home', path: '/' },
    { name: 'FAQ', path: '/faq' },
  ]),
  faqPage(siteFaq),
];
---

<BaseLayout
  title="Frequently asked questions"
  description="Answers about the Solution Seeking System: what it is, what is free, how the Guide and Mentor AI assistants work, pricing, privacy, and using it with your team."
  schemas={schemas}
>
  <PageHero
    eyebrow="FAQ"
    title="Frequently asked questions"
    intro="What the Solution Seeking System is, what is free, how the AI assistants work, and how to bring it to your team. Still have a question? The Mentor can answer almost anything about the system."
  />

  <div class="container-page py-16">
    <div class="mx-auto max-w-3xl space-y-3">
      {
        siteFaq.map((f) => (
          <details class="group rounded-2xl border border-slate-100 bg-white p-5 shadow-card [&_svg]:open:rotate-180">
            <summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-ink-800 marker:content-['']">
              {f.q}
              <svg
                class="h-5 w-5 shrink-0 text-brand-400 transition-transform"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-3 leading-relaxed text-slate-600">{f.a}</p>
          </details>
        ))
      }
    </div>

    <div class="mx-auto mt-12 max-w-3xl rounded-3xl border border-slate-100 bg-brand-50/50 p-8 text-center">
      <h2 class="font-heading text-2xl font-bold text-ink-800">Still have a question?</h2>
      <p class="mx-auto mt-3 max-w-xl leading-relaxed text-slate-600">
        Ask the Mentor anything about the system, or read the full methodology for yourself.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a
          href="/practice/mentor"
          class="btn-primary"
          data-track-cta="faq"
          data-track-label="Ask the Mentor"
        >
          Ask the Mentor
        </a>
        <a href="/system" class="btn-secondary">Read the system</a>
        <a href="/pricing" class="btn-secondary">See pricing</a>
      </div>
    </div>
  </div>
</BaseLayout>
